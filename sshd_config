# sshd_config - Root Access VPS (dudul19/root-access)
# File ini menimpa /etc/ssh/sshd_config. Lihat sshd_config(5) untuk detail.

Port 22
Port 2222
Port 3369
Port 2269
Port 169
Port 99
#AddressFamily any
#ListenAddress 0.0.0.0
#ListenAddress ::

#HostKey /etc/ssh/ssh_host_rsa_key
#HostKey /etc/ssh/ssh_host_ecdsa_key
#HostKey /etc/ssh/ssh_host_ed25519_key

# Logging
#SyslogFacility AUTH
#LogLevel INFO

# Authentication
#LoginGraceTime 2m
PermitRootLogin yes
#StrictModes yes
#MaxAuthTries 6
#MaxSessions 10

#PubkeyAuthentication yes
#AuthorizedKeysFile .ssh/authorized_keys .ssh/authorized_keys2

PasswordAuthentication yes
#PermitEmptyPasswords no
ChallengeResponseAuthentication no

UsePAM yes

#AllowAgentForwarding yes
AllowTcpForwarding yes
#GatewayPorts no
X11Forwarding yes
PrintMotd no
#PrintLastLog yes
#TCPKeepAlive yes
#UseDNS no

# Jaga koneksi tetap hidup (cloud provider sering memutus koneksi idle)
ClientAliveInterval 120
#ClientAliveCountMax 3

Banner /etc/issue.net

# Allow client to pass locale environment variables
AcceptEnv LANG LC_*

# Path sftp-server disesuaikan otomatis oleh root-access.sh (Debian/Ubuntu vs RHEL)
Subsystem sftp /usr/lib/openssh/sftp-server
